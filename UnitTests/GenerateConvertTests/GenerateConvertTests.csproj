		<ProjectReference Include="..\..\Hand.Generators.Reflection\Hand.Generators.Reflection.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
		<ProjectReference Include="..\..\Hand.Generators.SyntaxScripting\Hand.Generators.SyntaxScripting.csproj" />
		<ProjectReference Include="..\..\Hand.Generators.System\Hand.Generators.System.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
		<ProjectReference Include="..\..\Hand.Generators.Types\Hand.Generators.Types.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
